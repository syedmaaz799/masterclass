# NeuralVarsity Masterclass — environment configuration template.
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# Validated at startup by src/lib/env.ts.

# ---- Client (browser-exposed; must be prefixed NEXT_PUBLIC_) ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ANALYTICS_ENABLED="false"

# ---- Server-only: NocoDB (never exposed to the browser) ----
NOCODB_BASE_URL="https://app.nocodb.com"
NOCODB_API_TOKEN="your-nocodb-api-token"
NOCODB_REGISTRATIONS_TABLE_ID="your-registrations-table-id"
NOCODB_SURVEY_TABLE_ID="your-survey-table-id"
NOCODB_FEEDBACK_TABLE_ID="your-feedback-table-id"
